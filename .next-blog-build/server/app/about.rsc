nt-semibold text-[#ff541f] hover:underline","children":"AI calling agents"}]," ","that answer and make phone calls around the clock,"," ",["$","$L8",null,{"href":"/ai-chatbots","className":"font-semibold text-[#ff541f] hover:underline","children":"AI chatbots"}]," ","that handle WhatsApp, Instagram, Messenger and website conversations, and"," ",["$","$L8",null,{"href":"/website-development","className":"font-semibold text-[#ff541f] hover:underline","children":"high-performance websites"}]," ","that turn visitors into inquiries. Our"," ",["$","$L8",null,{"href":"/digital-marketing","className":"font-semibold text-[#ff541f] hover:underline","children":"digital marketing and SEO"}]," ","work keeps those systems fed with qualified traffic."]}]]}],["$","section",null,{"children":[["$","h2",null,{"id":"who-we-are","className":"text-3xl font-bold text-zinc-900 mb-6","children":"Who we are"}],["$","p",null,{"children":["We are a United States based AI and digital solutions company that has been building software since ","2014",". Our team combines engineers who work daily with speech recognition, large language models and telephony, with designers and marketers who understand what a small business actually needs: more booked appointments, fewer missed calls and less admin."]}],["$","p",null,{"className":"mt-4","children":["We serve clinics, real estate agencies, gyms, salons, home-service companies and e-commerce brands across North America, Europe and the Middle East. See how those deployments look in practice on our"," ",["$","$L8",null,{"href":"/use-cases","className":"font-semibold text-[#ff541f] hover:underline","children":"industry use cases"}]," ","page."]}]]}],["$","section",null,{"children":[["$","h2",null,{"id":"why-choose-us","className":"text-3xl font-bold text-zinc-900 mb-8","children":"Why businesses choose our AI calling agents"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-8 not-prose","children":[["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-zinc-900/10","children":[["$","h3",null,{"className":"text-xl font-semibold text-(--primary-color) mb-3","children":"Boost sales effortlessly"}],["$","p",null,{"className":"text-zinc-700","children":"Our AI calling agents qualify leads, schedule appointments and follow up with prospects automatically, so your sales team spends its time closing deals."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-zinc-900/10","children":[["$","h3",null,{"className":"text-xl font-semibold text-(--primary-color) mb-3","children":"Enhance customer support 24/7"}],["$","p",null,{"className":"text-zinc-700","children":"Never miss a call again. Our voice agents handle inquiries, give accurate answers from your own knowledge base and hand off to a human whenever it matters."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-zinc-900/10","children":[["$","h3",null,{"className":"text-xl font-semibold text-(--primary-color) mb-3","children":"Cut costs and increase efficiency"}],["$","p",null,{"className":"text-zinc-700","children":"One AI calling agent handles hundreds of simultaneous calls. Replace call center overhead with a fixed setup fee and predictable usage pricing."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-zinc-900/10","children":[["$","h3",null,{"className":"text-xl font-semibold text-(--primary-color) mb-3","children":"Customizable for your business"}],["$","p",null,{"className":"text-zinc-700","children":"Every agent is built around your scripts, your calendar and your CRM. Voice, tone, languages and escalation rules all match your brand."}]]}]]}]]}],["$","section",null,{"children":[["$","h2",null,{"id":"how-we-work","className":"text-3xl font-bold text-zinc-900 mb-6","children":"How we work"}],["$","ol",null,{"className":"list-decimal pl-6 space-y-3","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Discovery call."}]," A free consultation where we map your 