2:T4e0,{"@context":"https://schema.org","@type":["Organization","ProfessionalService"],"@id":"https://www.syenxatech.com/#organization","name":"Syenxa Tech","legalName":"Syenxa Tech","url":"https://www.syenxatech.com","logo":{"@type":"ImageObject","url":"https://www.syenxatech.com/logo-mark.png","width":512,"height":512},"image":"https://www.syenxatech.com/og-image.jpg","description":"Syenxa Tech builds AI calling agents, chatbots, websites, apps, and automation solutions that help businesses capture leads, support customers, and scale operations.","foundingDate":"2014","email":"syenxatech@gmail.com","telephone":"+1 289 796-3492","contactPoint":[{"@type":"ContactPoint","telephone":"+1 289 796-3492","email":"syenxatech@gmail.com","contactType":"sales","areaServed":"Worldwide","availableLanguage":["en"]}],"sameAs":["https://www.linkedin.com/company/syenxatech","https://www.instagram.com/syenxatech/","https://www.facebook.com/people/SyenxaTech/61584113090992/"],"address":{"@type":"PostalAddress","addressRegion":"TX","addressCountry":"US"},"areaServed":[{"@type":"Country","name":"United States"},"Worldwide"],"knowsAbout":["AI calling agents","AI voice agents","AI chatbots","AI automation","Next.js website development","digital marketing"]}c:Tb8d,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What services does Syenxa Tech offer?","acceptedAnswer":{"@type":"Answer","text":"Syenxa Tech provides AI calling agents (voice AI for inbound and outbound calls), AI chatbots for WhatsApp, Instagram, Messenger, TikTok and websites, custom Next.js website development, and digital marketing with SEO. Everything is built to automate customer communication and grow revenue."}},{"@type":"Question","name":"What are AI calling agents and how do they work?","acceptedAnswer":{"@type":"Answer","text":"AI calling agents are automated voice systems that talk like humans. They answer inbound calls, run outbound follow-ups, qualify leads, send reminders and book appointments using conversational AI, and they work 24/7 in multiple languages."}},{"@type":"Question","name":"What is the pricing for AI calling agents?","acceptedAnswer":{"@type":"Answer","text":"AI calling agent pricing is custom and depends on call volume, call duration, languages and region. We start with a free consultation and then propose a package with a fixed setup fee plus usage."}},{"@type":"Question","name":"How much does an AI chatbot cost?","acceptedAnswer":{"@type":"Answer","text":"Our AI chatbots are a one-time setup fee of $150 to $350 USD depending on channels and integrations. There are no monthly charges from us, and you get a free 7-day trial to test the bot on your own platform before committing."}},{"@type":"Question","name":"Can your chatbot work on WhatsApp and Instagram?","acceptedAnswer":{"@type":"Answer","text":"Yes. One chatbot can run on WhatsApp Business, Facebook Messenger, Instagram Direct Messages, TikTok DMs and your website live chat at the same time, all managed from a single setup."}},{"@type":"Question","name":"Do you offer a free chatbot trial?","acceptedAnswer":{"@type":"Answer","text":"Yes. We offer a 7-day free trial where the chatbot runs live on your platform so you can test its answers, share feedback and request changes before final delivery."}},{"@type":"Question","name":"How long does it take to deliver a chatbot?","acceptedAnswer":{"@type":"Answer","text":"Once requirements are finalized, a custom-built chatbot is delivered in about 3 working days. More complex integrations with CRMs or booking systems may take a few days longer."}},{"@type":"Question","name":"Do you build websites too?","acceptedAnswer":{"@type":"Answer","text":"Yes. We build fast, mobile-friendly, SEO-ready websites on Next.js, customized to your brand. Standard business websites start at $200 USD and are delivered within 5 to 7 working days; larger web applications are quoted separately."}},{"@type":"Question","name":"Is hosting and domain included in the website price?","acceptedAnswer":{"@type":"Answer","text":"No. Hosting and domain fees are paid to the provider separately, but we help you choose, set up and connect them at no extra charge."}}]}0:{"P":null,"b":"yPQDsGgS2YOaG1bkH_0le","p":"","c":["","services"],"i":false,"f":[[["",{"children":["services",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d9865c43b9b584ed.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/39eaee8db7c7ebe6.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/48c5094a76f5f408.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"suppressHydrationWarning":true,"className":"__variable_2ac210 __variable_176c1b __variable_d9d98a","children":[["$","a",null,{"href":"#content","className":"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-zinc-900 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white","children":"Skip to content"}],[["$","script","https://www.syenxatech.com/#organization",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}]],[["$","script","https://www.syenxatech.com/#website",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.syenxatech.com/#website\",\"name\":\"Syenxa Tech\",\"url\":\"https://www.syenxatech.com\",\"publisher\":{\"@id\":\"https://www.syenxatech.com/#organization\"},\"inLanguage\":\"en\"}"}}]],"$undefined",["$","$L3",null,{}],["$","$L4",null,{}],["$","$L5",null,{"config":{"color":"var(--primary-color)","direction":"right","durationIn":0.3,"holdDur